{
  "epochs": 100,
  "batch_size": 40,
  "dataloader_workers": 5,
  "learning_rate": 1e-3,
  "ckpt_dir": "checkpoint/",
  "monitor": "accuracy",
  "early_stopping": true,
  "patience": 50,
  "delta": 0.0,
  "disk_cache_video": true,
