{
  "epochs": 100,
  "batch_size": 40,
  "preload_workers": 16,
  "dataloader_workers": 5,
  "prefetch_factor": 1,
  "learning_rate": 1e-3,
  "ckpt_dir": "checkpoint/",
  "monitor": "accuracy",
  "early_stopping": true,
  "patience": 50,
  "delta": 0.0,
  "cache_video": true,
  "dataset_splitter": {
    "dataset_path": "/marimo/Fish_Feeding_Intensity_Dataset",
    "seed":42,
    "test_sample_per_class": 700,
    "save_results": true,
    "include_video": true
  },
  "video_features": {
    "image_size": 224,
    "frames": 20
  }
}
