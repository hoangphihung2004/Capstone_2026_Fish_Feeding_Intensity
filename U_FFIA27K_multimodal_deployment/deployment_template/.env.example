# Copy to .env and adjust. Deployment 2 shown; for Deployment 3 use 3 / 8013 / aquaffia-edge-3.
COMPOSE_PROJECT_NAME=aquaffia-edge-2
DEPLOYMENT_ID=2
DEPLOYMENT_NAME=Deployment 2
PORT=8012
CONTAINER_NAME=aquaffia-edge-2
IMAGE=aquaffia-edge-2:latest

# Python module that implements load / preprocess_audio / preprocess_video / infer
MODEL_MODULE=model

# Where your model files live on the Jetson (mounted read-only at /srv/deployment/weights)
WEIGHTS_SOURCE=./weights

# Shared simulation stream of Deployment 1 (do not change)
SIM_SOURCE=../aquaffia_edge_deployment/samples/continuous_simulation
