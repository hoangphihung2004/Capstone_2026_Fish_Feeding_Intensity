{
  "seed": 42,
  "device": "cuda",
  "num_classes": 4,
  "evaluation_mode": "holdout",
  "epochs": 300,
  "batch_size": 256,
  "learning_rate": 0.0001,
  "weight_decay": 0.0001,
  "optimizer": "adamw",
  "monitor": "accuracy",
  "early_stopping": true,
  "patience": 70,
  "delta": 0.0,
  "output_dir": "outputs",
  "model": {
    "name": "MultimodalStudentModel",
    "pretrained": true,
    "checkpoint_path": ""
  },
  "dataset": {
    "dataset_path": "/marimo/Fish_Feeding_Intensity_Dataset",
    "cache_audio": true,
    "cache_video": true,
    "video_cache_mode": "ram",
    "num_workers": -1,
    "prefetch_factor": null,
    "seed": 42,
    "split_strategy": "random_sample",
    "test_sample_per_class": 700,
    "num_folds": 5,
    "cv_val_ratio": 0.2
  },
  "audio_features": {
    "sample_rate": 64000,
    "window_size": 2048,
    "hop_size": 1024,
    "mel_bins": 128,
    "fmin": 1,
    "fmax": 32000,
    "time_drop_width": 64,
    "time_stripes_num": 2,
    "freq_drop_width": 8,
    "freq_stripes_num": 2,
    "freeze_parameters": true
  },
  "video_features": {
    "image_size": 224
  },
  "distillation": {
    "enabled": true,
    "mode": "offline",
    "hard_label_weight": 1.0,
    "alpha_logit": 1.0,
    "beta_feature": 2.0,
    "lambda_aux": 0.3,
    "audio_teacher": {
      "name": "PANNS_Cnn6",
      "checkpoint_path": "/marimo/Capstone_2026_Fish_Feeding_Intensity/Multimodal_Custom_Models/PANNS_Cnn6/DL_audio/checkpoint/panns_cnn6/audio_best.pt",
      "temperature": 4.0,
      "loss_weight": 0.5
    },
    "video_teacher": {
      "name": "EfficientNetB0",
      "checkpoint_path": "/marimo/Capstone_2026_Fish_Feeding_Intensity/Multimodal_Custom_Models/EfficientNetB0/U_FFIA_video/checkpoint/efficientnet_b0/video_best.pt",
      "temperature": 4.0,
      "loss_weight": 0.5
    }
  }
}

