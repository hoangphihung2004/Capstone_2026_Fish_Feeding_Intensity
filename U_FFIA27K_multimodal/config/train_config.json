{
  "epochs": 300,
  "batch_size": 256,
  "dataloader_workers": -1,
  "prefetch_factor": null,
  "learning_rate": 0.0001,
  "ckpt_dir": "checkpoint/",
  "monitor": "loss",
  "early_stopping": true,
  "patience": 40,
  "delta": 0.0,
  "audio_loss_weight": 1.0,
  "video_loss_weight": 1.0,
  "multimodal_loss_weight": 1.0,
  "cache_audio": true,
  "cache_video_mode": "ram",
  "model": {
    "audio_backbone": "LightweightAudioEncoder",
    "video_backbone": "EfficientNetB0_S7",
    "pretrained_audio": false,
    "pretrained_video": true
  },
  "dataset_splitter": {
    "dataset_path": "/marimo/Fish_Feeding_Intensity_Dataset",
    "seed": 42,
    "test_sample_per_class": 700,
    "save_results": false,
    "split_strategy": "random_sample",
    "evaluation_mode": "holdout",
    "num_folds": 5,
    "fold_index": null,
    "cv_val_ratio": 0.2
  },
  "audio_features": {
    "sample_rate": 64000,
    "window_size": 2048,
    "hop_size": 1024,
    "mel_bins": 128,
    "time_drop_width": 64,
    "time_stripes_num": 2,
    "freq_drop_width": 8,
    "freq_stripes_num": 2
  },
  "video_features": {
    "image_size": 224
  }
}
