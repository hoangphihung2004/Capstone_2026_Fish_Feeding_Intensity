{
  "epochs": 400,
  "batch_size": 256,
  "dataloader_workers": -1,
  "prefetch_factor": null,
  "learning_rate": 0.001,
  "ckpt_dir": "checkpoint/",
  "monitor": "accuracy",
  "early_stopping": false,
  "patience": 50,
  "delta": 0.0,
  "cache_audio": true,
  "cache_video_mode": "ram",
  "lr_scheduler": {
    "enabled": false,
    "factor": 0.5,
    "patience": 10,
    "threshold": 0.001,
    "cooldown": 2,
    "min_lr": 1e-06
  },
  "kd": {
    "teacher_checkpoint": "/marimo/Results/Fold0/U_FFIA27K_multimodal/checkpoint/multimodal_model/fold_00/multimodal_best.pt",
    "temperature": 4.0,
    "ce_weight": 1.0,
    "alpha": 0.5,
    "beta": 0.1,
    "feature_target": "none",
    "feature_source": "delta",
    "feature_stages": [
      2,
      3,
      4,
      5
    ],
    "stage_weights": null,
    "verify_teacher_split": true
  },
  "student": {
    "type": "stft_tkeo_mlp",
    "mlp": {
      "hidden_dims": [
        768,
        512
      ],
      "embed_dim": 384,
      "dropout": 0.1
    }
  },
  "model": {
    "audio_backbone": "LightweightAudioEncoder",
    "video_backbone": "EfficientNetB0_S7",
    "pretrained_audio": false,
    "pretrained_video": true
  },
  "dataset_splitter": {
    "dataset_path": "/marimo/Fish_Feeding_Intensity_Dataset",
    "seed": 42,
    "test_sample_per_class": 700,
    "save_results": false,
    "split_strategy": "random_sample",
    "evaluation_mode": "cross_validation",
    "num_folds": 5,
    "fold_index": 0,
    "cv_val_ratio": 0.2
  },
  "audio_features": {
    "sample_rate": 64000,
    "window_size": 2048,
    "hop_size": 1024,
    "mel_bins": 128,
    "time_drop_width": 64,
    "time_stripes_num": 2,
    "freq_drop_width": 8,
    "freq_stripes_num": 2
  },
  "stft_features": {
    "sample_rate": 256000,
    "window_size": 4096,
    "hop_size": 2048,
    "use_tkeo": true,
    "alpha_max": 0.99,
    "beta": 0.8,
    "use_spectral_aug": true,
    "cutout_width": 24,
    "cutout_prob": 0.5,
    "noise_std": 0.02
  },
  "video_features": {
    "image_size": 224
  }
}
