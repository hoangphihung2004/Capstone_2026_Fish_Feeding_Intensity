{
  "folds": [0, 1, 2, 3, 4],
  "split": "test",
  "batch_size": 64,
  "seed": 42,
  "audio_noise": {
    "type": "gaussian_white",
    "snr_db": [30, 25, 20, 15, 10, 5, 0, -5, -10, -15, -20, -25, -30],
    "domain": "waveform"
  },
  "video_pgd": {
    "mode": "sweep",
    "epsilon": 0.03137254902,
    "sweep": { "start": 0.00001, "end": 1.0, "num": 16, "spacing": "log" },
    "include_epsilons": [0.03137254902],
    "sanity_epsilon": 0.03137254902,
    "norm": "linf",
    "alpha_ratio": 0.25,
    "steps": 20,
    "random_start": true,
    "loss": "cross_entropy"
  },
  "metrics": ["accuracy", "f1_macro", "f1_weighted", "mAP", "confusion_matrix"]
}
